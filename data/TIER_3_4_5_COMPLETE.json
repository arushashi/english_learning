    "tier_3_medium_impact": {
      "title": "Tier 3: Medium-Impact Gaps",
      "modules": [
        {
          "id": 1,
          "title": "Numbers & Quantities (Complete Module)",
          "kannadaTitle": "ಸಂಖ್ಯೆಗಳು ಮತ್ತು ಪ್ರಮಾಣ (ಸಂಪೂರ್ಣ ಮಾಡ್ಯೂಲ್)",
          "cefr": "A1-B1",
          "lessons": [
            {
              "id": 1,
              "title": "Cardinal Numbers (1-1,000,000)",
              "examples": ["1 one", "10 ten", "100 hundred", "1,000 thousand", "10,000 ten thousand", "1,00,000 one lakh", "10,00,000 ten lakh", "1,00,00,000 one crore"]
            },
            {
              "id": 2,
              "title": "Ordinal Numbers",
              "examples": ["1st first", "2nd second", "3rd third", "10th tenth", "21st twenty-first", "100th hundredth"]
            },
            {
              "id": 3,
              "title": "Indian vs. International System",
              "examples": ["1,50,000 (Indian) = 150,000 (International)", "10,00,000 (Indian lakh) = 1 million (International)"]
            },
            {
              "id": 4,
              "title": "Phone Numbers, PIN Codes, Account Numbers",
              "examples": ["9876543210 (nine-eight-seven-six...)", "PIN: 560001", "Account: 1234567890"]
            },
            {
              "id": 5,
              "title": "Dates & Date Formats",
              "examples": ["DD/MM/YYYY (Indian): 28/07/2024", "MM/DD/YYYY (American): 07/28/2024"]
            },
            {
              "id": 6,
              "title": "Time & Time Expressions",
              "examples": ["6:30 AM (six thirty)", "14:45 (two forty-five PM)", "Quarter past six", "Half past seven"]
            },
            {
              "id": 7,
              "title": "Fractions, Decimals, Percentages",
              "examples": ["1/2 (one half)", "0.5 (zero point five)", "50% (fifty percent)"]
            },
            {
              "id": 8,
              "title": "Money & Currency",
              "examples": ["₹100 (one hundred rupees)", "$50 (fifty dollars)", "€25 (twenty-five euros)"]
            },
            {
              "id": 9,
              "title": "Weights, Measures, Temperature, Distance",
              "examples": ["1 kg (one kilogram)", "5 meters", "30°C (thirty degrees Celsius)", "10 km (ten kilometers)"]
            },
            {
              "id": 10,
              "title": "Approximations",
              "examples": ["About 50 people", "Nearly 100 rupees", "Roughly 5 hours", "Over 1000 students", "Under 500 rupees"]
            }
          ]
        },
        {
          "id": 2,
          "title": "Word Formation (Prefixes, Suffixes, Root Words)",
          "kannadaTitle": "ಪದ ರಚನೆ (ಪೂರ್ವಪದ, ಪ್ರತ್ಯಯ, ಮೂಲ ಪದ)",
          "cefr": "B1-B2",
          "lessons": [
            {
              "title": "Common Prefixes",
              "examples": [
                "un- (unhappy, unclear, undo)",
                "re- (redo, rewrite, restart)",
                "pre- (preview, prepare, predict)",
                "dis- (disagree, dislike, disappear)",
                "mis- (misunderstand, misspell, misuse)",
                "over- (overwork, overflow, overcome)",
                "under- (understand, underestimate, underline)"
              ]
            },
            {
              "title": "Common Suffixes",
              "examples": [
                "-tion (action, creation, education)",
                "-ment (agreement, development, improvement)",
                "-able (comfortable, reasonable, available)",
                "-ful (beautiful, helpful, wonderful)",
                "-less (hopeless, homeless, careless)",
                "-ness (happiness, sadness, kindness)",
                "-ly (quickly, slowly, carefully)",
                "-er (teacher, worker, player)",
                "-est (biggest, smallest, fastest)"
              ]
            },
            {
              "title": "Root Words",
              "examples": [
                "graph (write): photograph, biography, paragraph",
                "port (carry): transport, import, export",
                "dict (speak): dictionary, predict, contradict",
                "struct (build): structure, construct, instruct",
                "scribe (write): describe, prescribe, subscribe"
              ]
            }
          ]
        },
        {
          "id": 3,
          "title": "Synonyms, Antonyms, Homophones, Homonyms",
          "kannadaTitle": "ಸಮಾನಾರ್ಥಕ, ವಿರುದ್ಧಾರ್ಥಕ, ಸಮಧ್ವನಿ, ಸಮನಾಮ",
          "cefr": "B1",
          "lessons": [
            {
              "title": "Synonyms",
              "examples": [
                "happy = joyful, cheerful, delighted",
                "big = large, huge, enormous",
                "beautiful = pretty, lovely, gorgeous",
                "smart = intelligent, clever, bright",
                "tired = exhausted, fatigued, weary"
              ]
            },
            {
              "title": "Antonyms",
              "examples": [
                "happy ≠ sad",
                "big ≠ small",
                "hot ≠ cold",
                "fast ≠ slow",
                "rich ≠ poor"
              ]
            },
            {
              "title": "Homophones",
              "examples": [
                "to/too/two",
                "their/there/they're",
                "right/write",
                "see/sea",
                "hear/here"
              ]
            },
            {
              "title": "Homonyms",
              "examples": [
                "bank (financial institution / river bank)",
                "bat (animal / sports equipment)",
                "bow (weapon / to bend)",
                "lead (metal / to guide)",
                "tear (to rip / from crying)"
              ]
            }
          ]
        },
        {
          "id": 4,
          "title": "Collocations, Idioms, Phrasal Verbs, Proverbs",
          "kannadaTitle": "ಸಂಯೋಜನೆ, ಪದಸಮೂಹ, ಕ್ರಿಯಾ ಸಮೂಹ, ಗಾದೆಗಳು",
          "cefr": "B1-B2",
          "lessons": [
            {
              "title": "Collocations",
              "examples": [
                "strong tea (not powerful tea)",
                "heavy rain (not strong rain)",
                "make a decision (not do a decision)",
                "take a break (not have a break)",
                "do homework (not make homework)"
              ]
            },
            {
              "title": "Idioms",
              "examples": [
                "raining cats and dogs (raining heavily)",
                "break the ice (start a conversation)",
                "piece of cake (very easy)",
                "hit the books (study hard)",
                "under the weather (feeling sick)"
              ]
            },
            {
              "title": "Phrasal Verbs",
              "examples": [
                "put on (wear)",
                "take off (remove)",
                "look after (care for)",
                "get up (wake up)",
                "turn off (switch off)"
              ]
            },
            {
              "title": "Proverbs",
              "examples": [
                "Practice makes perfect",
                "Actions speak louder than words",
                "Better late than never",
                "Don't judge a book by its cover",
                "The early bird catches the worm"
              ]
            }
          ]
        }
      ]
